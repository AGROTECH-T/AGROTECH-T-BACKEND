# AGROTECH-T-BACKEND — variables de entorno (EJEMPLO, sin secretos reales)
# Copiar a .env y completar en local. El archivo .env nunca se commitea.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# Base de datos única (MariaDB). Las pruebas fuerzan SQLite y no usan estos valores.
DB_ENGINE=django.db.backends.mysql
DB_NAME=agrotech_t
DB_USER=agrotech_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=localhost
# Puerto de MariaDB en el equipo. DataGrip se conecta a localhost con este valor.
DB_PORT=3306
# Si el entorno la define, sustituye a MariaDB. Render la carga en el servicio.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0

# Claves de sesión y OTP. Generarlas en local; no reutilizar ejemplos.
JWT_ENCRYPTION_KEY=
JWT_TTL_MINUTES=15
OTP_HMAC_KEY=
OTP_TTL_MINUTES=5

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
