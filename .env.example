# AGROTECH-T-BACKEND — variables de entorno (EJEMPLO, sin secretos reales)
# Copiar a .env y completar con valores locales. El archivo .env NUNCA se commitea.

DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos única del proyecto (MariaDB). NO crear múltiples BD en esta etapa.
DB_ENGINE=django.db.backends.mysql
DB_NAME=agrotech_t
DB_USER=agrotech_user
DB_PASSWORD=change-me-in-local-env
DB_HOST=localhost
DB_PORT=3306
