# AGROTECH-T-BACKEND — variables de entorno (EJEMPLO, sin secretos reales)
# Copiar a .env y completar en local. El archivo .env nunca se commitea.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# Base de datos única (MariaDB). Las pruebas fuerzan SQLite y no usan estos valores.
DB_ENGINE=django.db.backends.mysql
DB_NAME=agrotech_t
DB_USER=agrotech_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=localhost
# Puerto de MariaDB en el equipo. DataGrip se conecta a localhost con este valor.
DB_PORT=3306
# Si el entorno la define, sustituye a MariaDB. Render la carga en el servicio.
DATABASE_URL=
# true solo cuando el servidor MariaDB exige TLS. Layerbase lo exige.
DB_SSL=
REDIS_URL=redis://127.0.0.1:6379/0

# Claves de sesión y OTP. Generarlas en local; no reutilizar ejemplos.
JWT_ENCRYPTION_KEY=
JWT_TTL_MINUTES=15
OTP_HMAC_KEY=
OTP_TTL_MINUTES=5

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=
# Remitente del SMS, de 1 a 11 letras o números. Ejemplo: AGROTECH
BREVO_SMS_SENDER=
# Número de WhatsApp de Brevo, con indicativo y sin signos.
BREVO_WHATSAPP_SENDER=
# Id de la plantilla de WhatsApp. La variable del código debe llamarse 1.
BREVO_WHATSAPP_TEMPLATE_ID=

# --- IoT / MQTT (MVP) -------------------------------------------------------
# Consumidor Django (manage.py mqtt_consumer). MQTT 5, topic agrotech/v1/gw/+/up.
# Obligatorio. Broker Flespi: mqtt.flespi.io
MQTT_HOST=
# 1..65535. Por defecto 1883; con TLS en Flespi usar 8883.
MQTT_PORT=
# Obligatorio. Identificador único del consumidor (ej. agrotech-django-staging).
MQTT_CLIENT_ID=
# Token ACL de Flespi para Django (solo Subscribe). Nunca un token Master.
MQTT_USERNAME=
# Flespi no usa contraseña: dejar SIN definir (si se define requiere MQTT_USERNAME).
# MQTT_PASSWORD=
# true|false. Obligatorio true en producción (DEBUG=False).
MQTT_TLS=
# Ruta absoluta a un PEM existente; requiere MQTT_TLS=true.
# CA pública incluida: infrastructure/certs/globalsign-root-r6.pem
MQTT_CA_CERTS=
# Prohibido en producción; requiere MQTT_TLS=true. No usar.
# MQTT_TLS_INSECURE=false
# 60..4294967295 s. Por defecto 86400. Debe ser > 0 para no perder QoS 1 al desconectar.
MQTT_SESSION_EXPIRY_SECONDS=
# Opcionales (valores por defecto): MQTT_KEEPALIVE=60 (5..3600),
# MQTT_RECONNECT_MIN_DELAY=1, MQTT_RECONNECT_MAX_DELAY=60 (1..3600),
# MQTT_MAX_PERSISTENCE_FAILURES=5 (1..100), MQTT_MAX_CONNECT_FAILURES=20 (1..1000).

# Clave maestra AES-256-GCM: cifra las claves HMAC de coordinador y los payloads
# MQTT recibidos. Base64 que decodifique a EXACTAMENTE 32 bytes. Sin valor por
# defecto ni alternativa con SECRET_KEY. Perderla inutiliza las credenciales.
COORDINATOR_KEY_ENCRYPTION_KEY=
# Entero 1..65535. Por defecto 1.
COORDINATOR_KEY_ENCRYPTION_KEY_VERSION=
# Versiones históricas: version:base64[,version:base64]. Vacío si no hay rotación.
# COORDINATOR_KEY_ENCRYPTION_KEY_PREVIOUS=

# Clave HMAC de huellas de credenciales de gateway. Mínimo 32 caracteres y
# distinta de DJANGO_SECRET_KEY. Sin alternativa con SECRET_KEY.
GATEWAY_CREDENTIAL_HMAC_KEY=

# Identidad del broker: off | record (enforce no está habilitado).
# record exige IOT_BROKER_IDENTITY_HMAC_KEY (Base64 de 32 bytes, independiente
# de las demás claves) e IOT_BROKER_IDENTITY_HMAC_KEY_VERSION (1..65535).
IOT_BROKER_IDENTITY_MODE=
# IOT_BROKER_IDENTITY_HMAC_KEY=
# IOT_BROKER_IDENTITY_HMAC_KEY_VERSION=
